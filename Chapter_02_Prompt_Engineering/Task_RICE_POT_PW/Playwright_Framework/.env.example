# ------------------------------------------------------------------
# VWO Login - environment template. Copy to "../.env" (Task_RICE_POT_PW/.env)
# and fill in real values. NEVER commit the real .env file.
# The framework loads the .env from the Task_RICE_POT_PW folder.
# ------------------------------------------------------------------

# Application under test
BASE_URL=https://app.wingify.com/#/login

# Valid account credentials
VWO_USERNAME=your.email@example.com
VWO_PASSWORD=your-password

# Optional overrides (defaults applied when unset)
# HEADLESS=false
# BROWSER=chromium
# ACTION_TIMEOUT_MS=15000
# NAVIGATION_TIMEOUT_MS=30000

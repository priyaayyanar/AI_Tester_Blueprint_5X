{
  "name": "vwo-playwright-framework",
  "version": "1.0.0",
  "description": "Enterprise-level Playwright + TypeScript automation framework (POM) for the VWO login application.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chrome --headed",
    "test:chrome": "playwright test --project=chrome",
    "test:edge": "playwright test --project=edge",
    "test:valid": "playwright test --project=chromium tests/valid-login.spec.ts",
    "test:invalid": "playwright test --project=chromium tests/invalid-login.spec.ts",
    "typecheck": "tsc --noEmit",
    "report:html": "playwright show-report",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "allure:serve": "allure serve ./allure-results",
    "clean": "rimraf allure-results allure-report playwright-report test-results"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "page-object-model",
    "allure",
    "vwo"
  ],
  "author": "Senior QA Automation Engineer / SDET",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.9.0",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}
